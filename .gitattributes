# Normalize text in the repository; keep source and documentation portable.
* text=auto
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.c text eol=lf
*.h text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# Preserve Windows script line endings if these scripts are added later.
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.zip binary
