<Window x:Class="BoardSimulator.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BoardSimulator.Wpf"
        mc:Ignorable="d"
        Title="BoardSim" Height="450" Width="800">
    <Grid>
        <Border Width="240" Height="140" BorderBrush="Gray" BorderThickness="2"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <TextBlock Text="Controller" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse x:Name="ButtonPinMarker"
                         Width="14" Height="14" Fill="Gray"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Margin="0,0,-7,0" ToolTip="BTN — controller pin" />
            </Grid>
        </Border>
    </Grid>
</Window>
